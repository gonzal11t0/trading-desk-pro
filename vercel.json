
{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install --include=dev",
    "rewrites": [
    {
      "source": "/api/argentina-datos/:path*",
      "destination": "https://api.argentinadatos.com/:path*"
    },
    {
      "source": "/api/fmp/:path*",
      "destination": "https://financialmodelingprep.com/:path*"
    },
    {
      "source": "/api/eoddata/:path*",
      "destination": "https://eoddata.com/:path*"
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/upgrade", "dest": "/index.html" },
    { "src": "/analisis-premium", "dest": "/index.html" },
    { "src": "/dashboard", "dest": "/index.html" },
    { "src": "/admin", "dest": "/index.html" },
    { "src": "/login", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
  
}
